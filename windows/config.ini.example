# =============================================================================
#  校园网自动登录 - Windows 配置（CampusLogin.ps1 读取本文件）
#  改完保存即可，下一次检测自动生效
# =============================================================================

# ---------- 必填 ----------
USERNAME="账号"
PASSWORD="在这里填你的密码"

# ---------- 认证门户 ----------
PORTAL_HOST="dgauth.xhsysu.cn"
PORTAL_PATH="/ac_portal/login.php"
PORTAL_SCHEME="https"

# ---------- 密码加密方式 ----------
# auto = 自动（先 RC4，失败换明文，并记住成功的方式）
# rc4  = 只用 RC4
# plain= 只用明文
ENCRYPT="auto"

# ---------- 行为 ----------
# 守护/计划任务多久检测一次（秒）
INTERVAL=60
# 请求超时（秒）
TIMEOUT=8
