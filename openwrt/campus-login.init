#!/bin/sh /etc/rc.common
# /etc/init.d/campus-login  —— 广州新华学院校园网自动登录（OpenWrt procd 服务）
# 安装：cp campus-login.init /etc/init.d/campus-login && chmod +x /etc/init.d/campus-login
#       /etc/init.d/campus-login enable && /etc/init.d/campus-login start

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/campus-login.sh
CONF=/etc/campus-login.conf
LOG=/var/log/campus-login.log

start_service() {
    [ -x "$PROG" ] || { logger -t campus-login "缺少 $PROG"; return 1; }
    [ -f "$CONF" ] || { logger -t campus-login "缺少 $CONF"; return 1; }

    procd_open_instance
    procd_set_param command "$PROG" daemon
    procd_set_param env CAMPUS_CONF="$CONF" CAMPUS_LOG="$LOG" INTERVAL="${INTERVAL:-60}"
    procd_set_param respawn 3600 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param nice 10
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "network"
}

stop_service() {
    logger -t campus-login "服务已停止"
}
