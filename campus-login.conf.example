# =============================================================================
#  校园网自动登录 - 配置文件
#  Windows 用 config.ini（同目录），Android/OpenWrt 用本文件（campus-login.conf）
#  修改后无需重启，下次检测即生效。
# =============================================================================

# ---------- 必填：学号 / 密码 ----------
USERNAME="账号"
PASSWORD="在这里填你的密码"

# ---------- 认证门户（一般不用改） ----------
# 学校认证域名
PORTAL_HOST="dgauth.xhsysu.cn"
# 登录接口路径（深信服 AC 标准接口）
PORTAL_PATH="/ac_portal/login.php"
# 协议：https（个别学校是 http）
PORTAL_SCHEME="https"

# ---------- 密码加密方式 ----------
# auto  = 先按 RC4 试，失败自动改用明文，并记住成功的方式（推荐）
# rc4   = 只用 RC4（学校页面用 RC4 加密时）
# plain = 只用明文
ENCRYPT="auto"

# ---------- 行为 ----------
# 守护模式多久检测一次（秒）
INTERVAL=60
# 单次请求超时（秒）
TIMEOUT=8
# Android Termux 下是否获取唤醒锁（1=是）
WAKE_LOCK=1
